# ECDAT Backend - Environment Variables

# Comma-separated list of allowed origins for CORS (or * for open staging)
CORS_ORIGINS=http://localhost:3000,https://ecdat.vercel.app

# Server Port (Auto-injected by Render, Railway, Cloud Run, Heroku)
PORT=8000

# Server Host Binding (0.0.0.0 is required for Docker and cloud environments)
HOST=0.0.0.0

# Environment Mode
ENVIRONMENT=production
