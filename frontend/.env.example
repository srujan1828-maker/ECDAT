# ECDAT Frontend - Environment Variables

# The publicly accessible URL of the deployed FastAPI backend API.
# Example: https://ecdat-backend.onrender.com/api
# For local development: http://127.0.0.1:8000/api
NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com/api

# Node environment
NODE_ENV=production

# Frontend port (optional, defaults to 3000)
PORT=3000
