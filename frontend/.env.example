# Copy to .env.local for local development, or configure on your hosting service.
# This is evaluated by the server at runtime, not baked into browser JavaScript.
BACKEND_API_URL=http://127.0.0.1:8000/api
# Optional shared secret. Keep this server-side; the proxy adds it upstream.
ECDAT_API_TOKEN=
# Proxy limits/timeouts for large scan uploads.
ECDAT_PROXY_MAX_BODY_MB=96
ECDAT_PROXY_TIMEOUT_MS=300000
