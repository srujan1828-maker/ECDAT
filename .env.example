# Backend-only configuration used by docker-compose.yml.
# Do not add this value to frontend/.env.local or expose it with a NEXT_PUBLIC_ prefix.
NVIDIA_API_KEY=nvapi-your-key-here

# Optional API access control and browser origin settings.
ECDAT_API_TOKEN=
ECDAT_ALLOWED_CIDRS=
CORS_ORIGINS=http://localhost:3000
