# ==============================================================================
# ECDAT Cloud Environment Variables Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Next.js)
# ------------------------------------------------------------------------------
# The public URL of your deployed FastAPI backend API.
# In production/cloud, this must be the publicly accessible HTTPS URL of the backend.
# NOTE: Next.js requires the "NEXT_PUBLIC_" prefix for browser access.
NEXT_PUBLIC_API_URL=https://your-backend-service.onrender.com/api

# Port for the frontend server (defaults to 3000)
PORT=3000

# Node environment mode
NODE_ENV=production


# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI / Uvicorn)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins for CORS.
# You can specify exact domains or use "*" for open staging/demo access.
# Example: https://ecdat.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=https://ecdat.vercel.app,https://your-frontend.onrender.com

# Port the backend binds to (cloud platforms like Render/Cloud Run inject this automatically)
PORT=8000

# Host binding (0.0.0.0 is mandatory for Docker and cloud containers)
HOST=0.0.0.0

# Environment mode
ENVIRONMENT=production
